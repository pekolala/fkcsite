RewriteEngine On

# HTTPS redirect
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# non-www to www redirect
RewriteCond %{HTTP_HOST} ^fujita-kc\.com [NC]
RewriteRule ^(.*)$ https://www.fujita-kc.com/$1 [R=301,L]

# Trigger redeploy to restore website files after server cleanup
